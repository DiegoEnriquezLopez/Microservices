APP_ENV=local
PAYMENT_TEST_CONTROLS_ENABLED=true
SERVICE_TOKEN=local-demo-token

PRODUCTS_URL=http://127.0.0.1:8001
PAYMENTS_URL=http://127.0.0.1:8004
PRODUCTS_DB_PATH=products-service/products.db
ORDERS_DB_PATH=orders-service/orders.db
PAYMENTS_DB_PATH=payments-service/payments.db
NOTIFICATIONS_DB_PATH=notifications.db

SERVICE_HTTP_TIMEOUT_SECONDS=2.0
PAYMENT_HTTP_TIMEOUT_SECONDS=2.0
PAYMENT_TIMEOUT_AFTER_COMMIT_SECONDS=3.0
PAYMENT_SCENARIO=approve
MAX_ORDER_QUANTITY=10

RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=student
RABBITMQ_PASSWORD=student-pass
STORE_QUEUE=notifications.confirmed.practice3

LOG_LEVEL=INFO
